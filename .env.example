# Copy to .env.local and fill in real values. Never commit .env.local.
# Keys are read only in server-side code (lib/server/env.ts, API routes) —
# they must never be exposed to the client.
#
# Each key below is scoped to exactly one purpose (one ElevenLabs/Groq
# account can issue multiple keys, each with its own restricted
# permissions) — do not reuse a key across purposes, and do not merge
# these back into one shared key per provider.

# Optional — ElevenLabs Text-to-Speech, generate-time only.
# Used by scripts/generate-fallback-audio.ts to write public/question-{id}.mp3.
# Runtime sensei audio is those committed clips, not live TTS.
ELEVENLABS_TTS_API_KEY=

# Required — Groq openai/gpt-oss-20b, used only for live tester-facing translation.
# Used by Issue 8 (POST /api/translate). Named per purpose, not GROQ_API_KEY.
GROQ_TRANSLATE_API_KEY=

# Required — Groq qwen/qwen3.8-27b, used only for POST /api/score grading.
# Used by Issue 11. Never reuse GROQ_TRANSLATE_API_KEY here.
GROQ_GRADE_API_KEY=

# Required — Groq Whisper, used only for background Japanese transcription
# of spoken answers (POST /api/scribe). Never reuse GRADE or TRANSLATE keys.
GROQ_STT_API_KEY=

# Optional — Deepgram Nova-3 live Japanese captions (POST /api/deepgram-stt
# mints a short-lived listen token). The long-lived key never goes to the
# browser. If absent, Speak fail-opens to browser captions + Groq Whisper.
DEEPGRAM_STT_API_KEY=

# Optional — ElevenLabs Speech-to-Text (Scribe). Unused after Groq Whisper;
# kept so an old key does not break a partial env.
ELEVENLABS_SCRIBE_API_KEY=

# Optional — Wispr Flow for live HUD captions. If absent, the app falls
# back to the browser Web Speech API using the same payload shape.
WISPR_API_KEY=

# Optional — Pitch demo gate. If absent, /pitch stays locked and
# /call?pitch=1 redirects to /pitch. Not a paid API; do not reuse any
# provider key here. POST /api/pitch/unlock sets an HttpOnly cookie.
PITCH_ACCESS_KEY=

# Optional — Supabase for invited-tester magic link, consent, and saved
# study sessions. Guests and Pitch work without these. Never expose the
# service role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
