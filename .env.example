# Copy to .env.local and fill in real values. Never commit .env.local.
# Keys are read only in server-side code (lib/server/env/*, API routes) —
# they must never be exposed to the client.
#
# Each key below is scoped to exactly one purpose — do not reuse a key
# across purposes, and do not merge these back into one shared key per provider.

# Optional — ElevenLabs Text-to-Speech, generate-time only.
# Used by scripts/generate-fallback-audio.ts to write public/question-{id}.mp3.
# Runtime sensei audio is those committed clips, not live TTS.
ELEVENLABS_TTS_API_KEY=

# Required — Groq qwen/qwen3.8-27b, used only for POST /api/score grading.
GROQ_GRADE_API_KEY=

# Optional — DeepSeek Flash grade fallback when Groq misses (POST /api/score).
# Absence means Groq miss → scoring unavailable (no sample Ready report).
DEEPSEEK_GRADE_API_KEY=

# Optional — Deepgram Nova-3 live Japanese captions (POST /api/deepgram-stt
# mints a short-lived listen token). The long-lived key never goes to the
# browser. If absent, Speak fail-opens to browser captions.
DEEPGRAM_STT_API_KEY=

# Optional — Help the study Google Form endpoint after the InterviewReport.
# If absent, the Usefulness step stays hidden.
RESEARCH_FORM_URL=

# Optional — Supabase for Participant Google login, consent, join-links,
# and full-session requests. Guests work without these. Never expose the
# service role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required when Participant login is enabled — signs proof that study consent
# was given during the current Google sign-in visit. Use a random 32+ byte key.
STUDY_VISIT_SIGNING_KEY=
